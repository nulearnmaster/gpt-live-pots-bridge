# Documentation only: this project never auto-loads an env file.
# Service only; supply real values privately and never commit them.
OPENAI_API_KEY=
# SIP only.
OPENAI_WEBHOOK_SECRET=
VOICE_WEBHOOK_PORT=8788
# WebRTC only; exact bare HTTPS origin on an owner-only private network.
VOICE_WEB_ORIGIN=
VOICE_WEB_PORT=8789
# Optional trusted-owner bookmark mode only. The key is separate from OpenAI.
# Provide it privately to the gate and serve, never the browser or worker.
VOICE_WEB_OWNER_LOGIN=
VOICE_WEB_PROXY_KEY=
# One of the allowlisted GPT-Live voices: marin (default) or coral.
VOICE_WEB_VOICE=marin
VOICE_STATE_DB=
VOICE_ADMIN_SOCKET=
# Default worker socket mode = 0600. Set yes only with an isolated group setup.
VOICE_SHARED_GROUP=no

# Both processes; absolute UDS path, not a URL.
VOICE_WORKER_SOCKET=
# Optional bare HTTPS origin; use the same value in both processes.
VOICE_LINK_ORIGIN=

# Worker only; fixed operator-owned configuration.
VOICE_POTS_BIN=
VOICE_POTS_BOT=
VOICE_RESULT_ADDRESS=
